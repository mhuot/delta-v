#!/bin/bash
# Block pushes to upstream remotes (OpenNMS and pbrane/delta-v)
remote="$1"
url="$2"

if echo "$url" | grep -qiE "opennms|pbrane/delta-v"; then
    echo ""
    echo "BLOCKED: You're trying to push to an upstream remote."
    echo "Remote: $remote"
    echo "URL: $url"
    echo ""
    echo "If you actually need to do this, remove .githooks/pre-push"
    exit 1
fi
