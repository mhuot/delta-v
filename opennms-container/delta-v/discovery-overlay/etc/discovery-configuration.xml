<discovery-configuration xmlns="http://xmlns.opennms.org/xsd/config/discovery"
    packets-per-second="1"
    initial-sleep-time="10000"
    restart-sleep-time="86400000"
    retries="2"
    timeout="3000">

    <!-- Home network discovery -->
    <include-range retries="2" timeout="3000" foreign-source="home-network" location="Default">
        <begin>192.168.1.1</begin>
        <end>192.168.1.254</end>
    </include-range>

</discovery-configuration>
