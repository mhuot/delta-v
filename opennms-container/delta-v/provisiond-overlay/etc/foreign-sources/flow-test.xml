<?xml version="1.0" encoding="UTF-8"?>
<!--
  Foreign source for Delta-V flow exporter test containers (softflowd, hsflowd).
  Minimal ICMP-only detection — no SNMP (sflow-exporter has no snmpd) and no
  cloud service LoopDetectors or label policies.
-->
<foreign-source xmlns="http://xmlns.opennms.org/xsd/config/foreign-source" name="flow-test">
    <scan-interval>1d</scan-interval>
    <detectors>
        <detector name="ICMP" class="org.opennms.netmgt.provision.detector.icmp.IcmpDetector"/>
    </detectors>
    <policies/>
</foreign-source>
